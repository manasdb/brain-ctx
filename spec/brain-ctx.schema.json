{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brainctx.dev/spec/v1/schema.json",
  "title": "brain.ctx",
  "description": "AI Constitution Standard v1.0 \u2014 invented by ManasDB",
  "type": "object",
  "required": [
    "version",
    "identity"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+$",
      "examples": [
        "1.0"
      ]
    },
    "identity": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "vision": {
          "type": "string"
        },
        "domain": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        }
      }
    },
    "inference": {
      "type": "object",
      "description": "How the system learns and adapts to codebase changes",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "mode": {
          "type": "string",
          "description": "propose_only: AI suggests updates; auto_apply: system updates itself (risky)",
          "enum": [
            "propose_only",
            "auto_apply",
            "disabled"
          ],
          "default": "propose_only"
        },
        "require_validation": {
          "type": "boolean",
          "description": "Must a human or test suite validate inferred rules?",
          "default": true
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "trust": {
      "type": "object",
      "description": "Enforcement layer: what AI agents are allowed to do",
      "properties": {
        "default": {
          "type": "string",
          "enum": [
            "read_only",
            "read_write",
            "no_access"
          ]
        },
        "mutex_files": {
          "type": "array",
          "description": "Paths that require explicit human approval for ANY modification",
          "items": {
            "type": "string"
          }
        },
        "never_touch": {
          "type": "array",
          "description": "Hard-blocked paths that AI agents cannot even read/see",
          "items": {
            "type": "string"
          }
        },
        "agents": {
          "type": "object",
          "description": "Role-based access control for different AI personas"
        }
      }
    },
    "hard_rules": {
      "type": "array",
      "description": "Operational invariants. Use 'ALWAYS: [action]' or 'NEVER: [action]' patterns for best results.",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "object",
      "description": "The 'Execution Layer': commands to prove correctness",
      "properties": {
        "test_command": {
          "type": "string",
          "description": "Command to run unit/integration tests (e.g., 'npm test')"
        },
        "lint_command": {
          "type": "string",
          "description": "Command to run linting/static analysis (e.g., 'ruff check .')"
        },
        "build_command": {
          "type": "string",
          "description": "Command to verify a successful build (e.g., 'tsc')"
        },
        "auto_verify": {
          "type": "boolean",
          "description": "Should the system run these commands automatically after edits?",
          "default": false
        }
      }
    },
    "ethics": {
      "type": "object",
      "properties": {
        "never_expose": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "never_delete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "data_sovereignty": {
          "type": "string"
        }
      }
    },
    "truth_sources": {
      "type": "object"
    },
    "cognitive": {
      "type": "object",
      "description": "Dynamic context optimization: what information matters most",
      "properties": {
        "critical": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "important": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "modes": {
          "type": "object",
          "description": "Task-specific priority overrides (e.g., debug, refactor, build)",
          "additionalProperties": {
            "type": "object",
            "required": [
              "prioritize"
            ],
            "properties": {
              "prioritize": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "dialects": {
      "type": "object"
    },
    "mesh": {
      "type": "object"
    },
    "observability": {
      "type": "object"
    },
    "signature": {
      "type": "object"
    },
    "inherit": {
      "type": "string",
      "description": "Path to parent brain.ctx to inherit from (local path or github://org/repo/brain.ctx)"
    },
    "conditional_rules": {
      "type": "array",
      "description": "Rules that only apply in certain environments or contexts",
      "items": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "rule"
            ],
            "properties": {
              "rule": {
                "type": "string"
              },
              "when": {
                "type": "object",
                "properties": {
                  "env": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "branch": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "role": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "path_changed": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    ]
                  },
                  "tags": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              },
              "severity": {
                "type": "string",
                "enum": [
                  "ERROR",
                  "WARN",
                  "INFO"
                ]
              },
              "reason": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "timeline": {
      "type": "array",
      "description": "Architectural decision history — why things are the way they are",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "event": {
            "type": "string"
          },
          "lesson": {
            "type": "string"
          },
          "hash": {
            "type": "string"
          }
        }
      }
    }
  }
}