{
  "name": "brain-ctx",
  "version": "1.0.0",
  "description": "brain.ctx — AI Constitution Standard. Self-maintaining project intelligence for every AI tool, agent, and model.",
  "author": "Bomberedman <hello@manasdb.com>",
  "license": "Apache-2.0",
  "homepage": "https://manasdb.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/manasdb/brain-ctx"
  },
  "keywords": [
    "ai",
    "agents",
    "llm",
    "context",
    "brain-ctx",
    "mcp",
    "cursor",
    "copilot",
    "manasdb",
    "ai-constitution"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./mcp": {
      "import": "./dist/mcp/index.mjs",
      "require": "./dist/mcp/index.js",
      "types": "./dist/mcp/index.d.ts"
    },
    "./parser": {
      "import": "./dist/parser/index.mjs",
      "require": "./dist/parser/index.js",
      "types": "./dist/parser/index.d.ts"
    }
  },
  "bin": {
    "brain-ctx": "./bin/brain-ctx.js"
  },
  "files": [
    "dist",
    "bin",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/mcp/index.ts src/parser/index.ts src/validator/index.ts src/vscode/index.ts --format cjs,esm --no-dts",
    "dev": "tsup src/index.ts --watch",
    "test": "vitest run --reporter=verbose",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "js-yaml": "^4.1.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "simple-git": "^3.22.0",
    "glob": "^10.3.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
